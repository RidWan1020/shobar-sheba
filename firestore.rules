rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portal Content: Public read for citizens, write only for authenticated admin
    match /portal_content/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Category collections: Public read, authenticated admin write
    match /{category}/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

